{
  "name": "beebmx/kirby-patrol",
  "description": "Patrol for Kirby",
  "license": "MIT",
  "type": "kirby-plugin",
  "version": "1.3.0",
  "keywords": [
    "security",
    "middleware",
    "users",
    "roles",
    "kirby",
    "kirby-plugin",
    "kirby4",
    "kirby5"
  ],
  "authors": [
    {
      "name": "Fernando Gutierrez",
      "homepage": "https://beeb.mx"
    }
  ],
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.1",
    "beebmx/kirby-middleware": "^1.0"
  },
  "require-dev": {
    "laravel/pint": "^1.10",
    "pestphp/pest": "^3.0",
    "spatie/ray": "^1.40",
    "getkirby/cms": "^4.0|^5.0"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "autoload": {
    "psr-4": {
      "Beebmx\\KirbyPatrol\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "extra": {
    "kirby-plugin-path": "tests/Fixtures/site/plugins"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
